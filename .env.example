# Frontend environment template. Copy to .env when deploying or using a
# non-default API host. Keep VITE_API_URL blank for local Vite proxy routing.
VITE_API_URL=
VITE_PUBLIC_APP_URL=http://localhost:5173

# Supabase CLI authentication. Keep this unprefixed so Vite never exposes it
# to browser code. Load it into the terminal environment before using the CLI.
SUPABASE_ACCESS_TOKEN=