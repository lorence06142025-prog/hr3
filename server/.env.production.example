# Production API environment checklist.
# Copy each value to your API host's encrypted environment-variable settings.
# Never commit a populated env file or paste credentials into VITE_ variables.

NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# Supabase: use the production PostgreSQL connection URL with SSL enabled.
DATABASE_URL=postgresql://<db-user>:<db-password>@<db-host>:5432/<db-name>?sslmode=require

# Generate a unique random value with at least 32 characters.
JWT_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET

# Exact public frontend origin, with no path or trailing route.
CLIENT_ORIGIN=https://app.example.com
PUBLIC_APP_URL=https://app.example.com
APP_URL=https://app.example.com

# Configure ONE email provider and a sender/domain verified with that provider.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Priority Handling Services, Inc.
RESEND_API_KEY=
RESEND_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional integrations
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
HR2_API_URL=
HR2_API_KEY=
