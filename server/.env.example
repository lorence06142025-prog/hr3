# Priority Handling Services, Inc. API environment template.
# Copy this file to server/.env for local development. Replace demo values
# before deploying; never commit server/.env or real service credentials.

# Server
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Local PostgreSQL. Create the perdevsys database first and adjust the
# username/password if your local PostgreSQL credentials differ.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/perdevsys

# Authentication. This value is only a local placeholder; use a unique,
# randomly generated secret in every deployed environment.
JWT_SECRET=replace-with-a-unique-random-secret-before-deploying

# CORS
CLIENT_ORIGIN=http://localhost:5173

# Public URLs used in certificate links (optional for local development)
PUBLIC_APP_URL=http://localhost:5173
APP_URL=http://localhost:5173

# OpenRouter AI (optional — reports are template-based if not set)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Email delivery (optional). Configure one provider; leave credentials blank
# to use the application's demo email behavior.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Priority Handling Services, Inc.
RESEND_API_KEY=
RESEND_FROM=

# SMTP alternative
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Priority Handling Services, Inc. <no-reply@example.com>"

# HR2 attendance integration (optional; demo data is used when unset)
HR2_API_URL=
HR2_API_KEY=

